{
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/delete-data", "destination": "/delete-data.html" },
    { "source": "/blog/why-training-alone-doesnt-work", "destination": "/blog/why-training-alone-doesnt-work.html" },
    { "source": "/blog/the-case-for-fitness-duels", "destination": "/blog/the-case-for-fitness-duels.html" },
    { "source": "/blog/what-to-look-for-in-a-social-fitness-app", "destination": "/blog/what-to-look-for-in-a-social-fitness-app.html" },
    { "source": "/blog/how-fitness-leagues-work", "destination": "/blog/how-fitness-leagues-work.html" },
    { "source": "/blog/the-psychology-of-going-live", "destination": "/blog/the-psychology-of-going-live.html" },
    { "source": "/blog/what-an-ai-fitness-coach-should-do", "destination": "/blog/what-an-ai-fitness-coach-should-do.html" },
    { "source": "/blog/why-group-fitness-challenges-fail", "destination": "/blog/why-group-fitness-challenges-fail.html" },
    { "source": "/blog/streak-freezes-explained", "destination": "/blog/streak-freezes-explained.html" },
    { "source": "/user/:id", "destination": "/404.html" },
    { "source": "/challenge/:id", "destination": "/404.html" },
    { "source": "/event/:id", "destination": "/404.html" },
    { "source": "/community/:id", "destination": "/404.html" },
    { "source": "/invite/:id", "destination": "/404.html" },
    { "source": "/post/:id", "destination": "/404.html" },
    { "source": "/u/:id", "destination": "/404.html" },
    { "source": "/c/:id", "destination": "/404.html" },
    { "source": "/e/:id", "destination": "/404.html" },
    { "source": "/t/:id", "destination": "/404.html" },
    { "source": "/i/:id", "destination": "/404.html" },
    { "source": "/p/:id", "destination": "/404.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
